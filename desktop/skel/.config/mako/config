# VeloGuardOS notifications (mako) — derived from Omarchy default/mako/core.ini
# (MIT). Theme colors are pulled from the active VeloGuard theme.

anchor=top-right
group-by=app-name,summary,body
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

# Fallback colors, then the active theme's (created/updated by `veloguard-theme`).
# The include MUST stay up here in the global section: inside a [criteria]
# section mako rejects it ("Failed to parse option 'include=…'") and exits —
# no notifications at all.
background-color=#13203a
text-color=#ffffff
border-color=#33ccff
include=~/.config/veloguard/current/mako.ini

[app-name=Spotify]
invisible=1

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0
layer=overlay
