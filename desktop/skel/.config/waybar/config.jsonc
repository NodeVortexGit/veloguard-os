// VeloGuardOS Waybar — the top bar as a quick panel (Frost). Everything is
// one click away: Wi-Fi and Bluetooth menus, volume, brightness, power
// profile, a calendar on the clock, every AI agent's usage, the guard's
// state — and  opens the quick panel (swaync: toggles, sliders, media,
// notifications). Derived from Omarchy's bar (MIT; desktop/omarchy/PROVENANCE.md).
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,
  "margin": "0",
  "modules-left": ["custom/veloguard", "hyprland/workspaces", "niri/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/ai-usage",
    "custom/guard",
    "hyprland/language",
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "power-profiles-daemon",
    "battery",
    "group/tray-expander",
    "custom/notifications",
    "custom/quickpanel"
  ],

  "custom/veloguard": {
    "format": "󰒃",
    "on-click": "veloguard-guard-menu",
    "on-click-right": "albert toggle",
    "tooltip-format": "VeloGuard — guard menu (Super+Ctrl or Super+Shift+G)\nRight-click: Albert search (Alt+Space)"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": { "default": "", "active": "󱓻" },
    "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
  },
  "niri/workspaces": { "format": "{icon}", "format-icons": { "default": "", "active": "󱓻" } },
  "hyprland/window": { "format": "{title}", "max-length": 48, "separate-outputs": true, "empty-format": "" },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%A, %d %B %Y — week %V}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month", "mode-mon-col": 3, "weeks-pos": "left", "on-scroll": 1,
      "format": {
        "months": "<span color='#d8dcea'><b>{}</b></span>",
        "days": "<span color='#a8b0c8'>{}</span>",
        "weeks": "<span color='#6a7290'>W{}</span>",
        "weekdays": "<span color='#6b9bff'><b>{}</b></span>",
        "today": "<span color='#ffffff' background='#3b5bd9'><b> {} </b></span>"
      }
    },
    "actions": { "on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  "custom/ai-usage": {
    "exec": "veloguard-ai-usage --waybar",
    "return-type": "json",
    "interval": 30,
    "signal": 8,
    "on-click": "veloguard-quickpanel --usage",
    "on-click-right": "veloguard-agent"
  },
  // VPN / Wi-Fi trust / staged update / an active root grant / guard health
  "custom/guard": {
    "exec": "veloguard-waybar-guard",
    "return-type": "json",
    "interval": 5,
    "signal": 7,
    "on-click": "veloguard-guard-menu",
    "on-click-right": "veloguard-guard-menu vpn"
  },
  "hyprland/language": {
    "format": "{short}",
    "on-click": "veloguard-switch-layout",
    "tooltip": false
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} · {signalStrength}% · {frequency} GHz\n{ipaddr}\nClick: Wi-Fi networks",
    "tooltip-format-ethernet": "Wired · {ipaddr}",
    "tooltip-format-disconnected": "Disconnected — click for Wi-Fi networks",
    "interval": 3,
    "on-click": "veloguard-wifi-menu",
    "on-click-right": "alacritty -e nmtui"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias} · {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
    "on-click": "veloguard-bt-menu",
    "on-click-right": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} · {volume}%"
  },
  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness {percent}%",
    "on-scroll-up": "brightnessctl s 5%+",
    "on-scroll-down": "brightnessctl s 5%-"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": { "performance": "󰓅", "balanced": "󰾅", "power-saver": "󰾆", "default": "󰾅" }
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format-discharging": "{power:>1.0f} W ↓ · {time}",
    "tooltip-format-charging": "{power:>1.0f} W ↑ · {time}",
    "interval": 5,
    "on-click": "veloguard-powermenu",
    "states": { "warning": 20, "critical": 10 }
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 400, "children-class": "tray-group-item" },
    "modules": ["custom/expand-icon", "tray"]
  },
  "custom/expand-icon": { "format": "", "tooltip": false },
  "tray": { "icon-size": 14, "spacing": 12 },
  // Notifications (swaync) — the bell: count / do-not-disturb; click opens them
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "exec-if": "which swaync-client",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚", "none": "󰂜",
      "dnd-notification": "󰂛", "dnd-none": "󰪑",
      "inhibited-notification": "󰂚", "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛", "dnd-inhibited-none": "󰪑"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "tooltip-format": "Notifications (Super+N) — right-click: do not disturb",
    "escape": true
  },
  // The quick panel (Quickshell): toggles, sliders, media, AI plan usage
  "custom/quickpanel": {
    "format": "󰒓",
    "tooltip-format": "Quick panel (Super)",
    "on-click": "veloguard-quickpanel"
  }
}
