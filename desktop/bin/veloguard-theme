#!/usr/bin/env bash
#
# veloguard-theme — switch the VeloGuardOS desktop theme. A theme is a directory
# under /usr/share/veloguard/themes/<name> holding hyprland.lua (Hyprland 0.55+;
# hyprland.conf for older ones), waybar.css, mako.ini, alacritty.toml,
# hyprlock.conf and gum.env.conf. The active theme is
# the symlink ~/.config/veloguard/current -> that directory; the desktop configs
# source files through that symlink, so switching is just a relink + reload.
#
#   veloguard-theme                 # same as: menu
#   veloguard-theme ensure          # make sure a theme is selected (default: veloguard)
#   veloguard-theme set <name>      # switch to a theme
#   veloguard-theme menu            # pick a theme (wofi, rofi or zenity — veloguard-dmenu)
#   veloguard-theme list            # list installed theme names
#   veloguard-theme current         # print the active theme name
#   veloguard-theme background      # print the active theme's wallpaper path
set -euo pipefail

THEMES_DIR="${VELOGUARD_THEMES_DIR:-/usr/share/veloguard/themes}"
DEFAULT_THEME="${VELOGUARD_DEFAULT_THEME:-frost}"
DEFAULT_BG="${VELOGUARD_DEFAULT_BG:-/usr/share/backgrounds/veloguard/default.png}"
CURRENT="${VELOGUARD_CURRENT:-$HOME/.config/veloguard/current}"

list_themes() {
  [ -d "$THEMES_DIR" ] || return 0
  for d in "$THEMES_DIR"/*/; do
    [ -d "$d" ] && basename "$d"
  done
}

current_name() {
  if [ -L "$CURRENT" ]; then basename "$(readlink -f "$CURRENT")"; fi
}

background_path() {
  local dir; dir="$(readlink -f "$CURRENT" 2>/dev/null || true)"
  if [ -n "$dir" ]; then
    for f in "$dir"/background "$dir"/background.png "$dir"/background.jpg; do
      [ -r "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
  fi
  printf '%s\n' "$DEFAULT_BG"
}

# Colour files for the desktops whose configs can't read Waybar's CSS: rofi,
# polybar, dunst, i3 and niri (in ~/.config/veloguard/generated, rewritten on every
# switch and session start from the theme's waybar.css palette).
GEN="${VELOGUARD_GENERATED:-$HOME/.config/veloguard/generated}"
generate() {
  local css; css="$(readlink -f "$CURRENT" 2>/dev/null)/waybar.css"
  [ -r "$css" ] || return 0
  mkdir -p "$GEN"
  python3 - "$css" "$GEN" <<'PY' || true
import re, sys, os
css, out = sys.argv[1], sys.argv[2]
c = {"background": (10, 10, 18, 0.55), "solid": "#0a0a12", "foreground": "#d8dcea", "accent": "#3b5bd9",
     "accent2": "#6b9bff", "muted": "#6a7290", "ok": "#7ee0a8", "warn": "#f2c66d", "alert": "#f26d7d"}
text = open(css, encoding="utf-8").read()
for name, value in re.findall(r"@define-color\s+([\w-]+)\s+([^;]+);", text):
    value = value.strip()
    m = re.fullmatch(r"rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)", value)
    if m:
        c[name] = (int(m[1]), int(m[2]), int(m[3]), float(m[4] if m[4] else 1))
    elif re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        c[name] = value.lower()
def hex6(v):
    return v if isinstance(v, str) else "#%02x%02x%02x" % v[:3]
def alpha(v, a=None):
    """#RRGGBBAA (rofi, dunst) with the colour's own alpha unless given"""
    if isinstance(v, str):
        return v + "%02x" % round(255 * (1 if a is None else a))
    return hex6(v) + "%02x" % round(255 * (v[3] if a is None else a))
def argb(v, a=None):
    """#AARRGGBB (polybar)"""
    h = alpha(v, a)
    return "#" + h[7:9] + h[1:7]
bg = c["background"]
solid, fg, acc, acc2, muted = hex6(c["solid"]), hex6(c["foreground"]), hex6(c["accent"]), hex6(c["accent2"]), hex6(c["muted"])
ok, warn, alert = hex6(c["ok"]), hex6(c["warn"]), hex6(c["alert"])
def w(name, body):
    tmp = os.path.join(out, name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(body)
    os.replace(tmp, os.path.join(out, name))
w("rofi-colors.rasi", f"""/* generated by veloguard-theme — do not edit */
* {{
    vg-bg: {alpha(bg, 0.9)};
    vg-solid: {solid};
    vg-fg: {fg};
    vg-accent: {acc};
    vg-accent2: {acc2};
    vg-muted: {muted};
    vg-alert: {alert};
}}
""")
w("polybar-colors.ini", f"""; generated by veloguard-theme — do not edit
[colors]
background = {argb(bg, 0.82)}
background-solid = {solid}
foreground = {fg}
accent = {acc}
accent2 = {acc2}
accent-glass = {argb(c["accent"], 0.35)}
muted = {muted}
ok = {ok}
warn = {warn}
alert = {alert}
""")
w("dunst.conf", f"""# generated by veloguard-theme — do not edit
[global]
    frame_color = "{acc}"
    highlight = "{acc2}"
    separator_color = frame
[urgency_low]
    background = "{alpha(c["solid"], 0.92)}"
    foreground = "{muted}"
[urgency_normal]
    background = "{alpha(c["solid"], 0.92)}"
    foreground = "{fg}"
[urgency_critical]
    background = "{alpha(c["solid"], 0.95)}"
    foreground = "#ffffff"
    frame_color = "{alert}"
""")
w("niri-colors.kdl", f"""// generated by veloguard-theme — do not edit
layout {{
    border {{
        active-color "{acc}"
        inactive-color "#12121a"
        urgent-color "{alert}"
    }}
}}
overview {{
    backdrop-color "{solid}"
}}
""")
w("i3-colors.conf", f"""# generated by veloguard-theme — do not edit
# class                 border   backgr.  text     indicator child_border
client.focused          {acc} {acc} #ffffff {acc2} {acc}
client.focused_inactive #12121a #12121a {fg} #12121a #12121a
client.unfocused        {solid} {solid} {muted} {solid} {solid}
client.urgent           {alert} {alert} #ffffff {alert} {alert}
client.placeholder      {solid} {solid} {fg} {solid} {solid}
client.background       {solid}
""")
PY
}

reload_session() {
  # Best-effort live reload; harmless (and silent) outside a graphical session.
  generate
  case "$(veloguard-session de 2>/dev/null)" in
    hyprland)
      hyprctl reload >/dev/null 2>&1 || true
      makoctl reload >/dev/null 2>&1 || true ;;
    i3)
      i3-msg reload >/dev/null 2>&1 || true
      polybar-msg cmd restart >/dev/null 2>&1 || true
      dunstctl reload >/dev/null 2>&1 || true ;;
    xfce)
      # the panel's own colour (solid, from the theme)
      local hex; hex="$(sed -n 's/^background-solid = #\(......\)$/\1/p' "$GEN/polybar-colors.ini" 2>/dev/null)"
      if [ -n "$hex" ]; then
        xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n \
          -t double -s "$(awk -v v="$((16#${hex:0:2}))" 'BEGIN{print v/255}')" \
          -t double -s "$(awk -v v="$((16#${hex:2:2}))" 'BEGIN{print v/255}')" \
          -t double -s "$(awk -v v="$((16#${hex:4:2}))" 'BEGIN{print v/255}')" \
          -t double -s 0.92 >/dev/null 2>&1 || true
      fi ;;
  esac
  pkill -SIGUSR2 -x waybar >/dev/null 2>&1 || true
  veloguard-session wallpaper >/dev/null 2>&1 || true
}

set_theme() {
  local name="$1"
  if [ ! -d "$THEMES_DIR/$name" ]; then
    echo "veloguard-theme: no such theme: $name" >&2
    echo "available: $(list_themes | paste -sd' ' -)" >&2
    return 1
  fi
  mkdir -p "$(dirname "$CURRENT")"
  ln -sfn "$THEMES_DIR/$name" "$CURRENT"
  reload_session
  command -v notify-send >/dev/null 2>&1 && notify-send "VeloGuard" "Theme: $name" || true
}

# mako configs seeded from the old skel end with the theme include INSIDE the
# [urgency=critical] section, where mako rejects it and exits — no
# notifications at all. Move it to the global section. Only that exact shipped
# layout (our comment + include as the last two lines) is touched.
fix_mako_include() {
  local f="$HOME/.config/mako/config" inc='include=~/.config/veloguard/current/mako.ini'
  [ -f "$f" ] || return 0
  # shellcheck disable=SC2016  # the backticks are literal text in the file
  [ "$(tail -n2 "$f" | head -n1)" = '# Theme colors (created/updated by `veloguard-theme`)' ] || return 0
  [ "$(tail -n1 "$f")" = "$inc" ] || return 0
  head -n -2 "$f" | sed -e '/[^[:space:]]/,$!d' | awk -v inc="$inc" \
    '!done && /^\[/ { print inc; print ""; done = 1 } { print } END { if (!done) print inc }' > "$f.vgtmp" \
    && mv -f "$f.vgtmp" "$f"
}

ensure_theme() {
  fix_mako_include
  if [ -d "$CURRENT" ] || { [ -L "$CURRENT" ] && [ -e "$CURRENT" ]; }; then
    return 0                                   # already points somewhere valid
  fi
  local first
  if [ -d "$THEMES_DIR/$DEFAULT_THEME" ]; then
    first="$DEFAULT_THEME"
  else
    first="$(list_themes | head -n1)"
  fi
  [ -n "$first" ] || { echo "veloguard-theme: no themes installed in $THEMES_DIR" >&2; return 1; }
  mkdir -p "$(dirname "$CURRENT")"
  ln -sfn "$THEMES_DIR/$first" "$CURRENT"
}

menu_pick() {
  local pick
  pick="$(list_themes | veloguard-dmenu --width 320 --height 260 -p "Theme")" || return 0
  [ -n "$pick" ] && set_theme "$pick"
}

case "${1:-menu}" in
  ensure)     ensure_theme && generate ;;
  set)        [ $# -ge 2 ] || { echo "usage: veloguard-theme set <name>" >&2; exit 2; }; set_theme "$2" ;;
  menu)       ensure_theme; menu_pick ;;
  list)       list_themes ;;
  current)    current_name ;;
  background) ensure_theme >/dev/null 2>&1 || true; background_path ;;
  *)          echo "usage: veloguard-theme {ensure|set <name>|menu|list|current|background}" >&2; exit 2 ;;
esac
