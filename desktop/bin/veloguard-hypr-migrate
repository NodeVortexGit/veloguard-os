#!/usr/bin/env python3
"""veloguard-hypr-migrate — move VeloGuardOS Hyprland accounts from hyprland.conf
to Lua. Hyprland 0.57 removed the hyprlang config: it reads only
~/.config/hypr/hyprland.lua and, when there is none, writes its own generic
default there — the account silently loses VeloGuard's keybinds, bar, theme
and every personal setting.

For each account whose ~/.config/hypr/hyprland.conf is VeloGuard's entry config:
  * installs VeloGuard's Lua entry (/etc/skel/.config/hypr/hyprland.lua) and the
    personal override files (monitors/input/bindings/looknfeel/autostart.lua);
  * converts the simple personal settings people actually change from the
    matching *.conf: monitor lines, input options (keyboard layout, repeat,
    touchpad), bind/unbind with exec, exec-once, simple general/decoration
    values. Anything it can't translate is kept as a commented original line
    in the .lua and listed in ~/.config/hypr/MIGRATED-FROM-CONF.txt;
  * replaces only Hyprland's own AUTOGENERATED hyprland.lua (kept as
    hyprland.lua.autogenerated); a user's hand-written Lua is never touched.
The *.conf files stay where they are. Idempotent.

    veloguard-hypr-migrate --all       # every account under /home (root)
    veloguard-hypr-migrate [USER...]   # just these (default: the caller)
"""
import os, pwd, re, shutil, sys

SKEL = "/etc/skel/.config/hypr"
MARK = "/usr/share/veloguard/desktop/hypr/"
PERSONAL = ("monitors", "input", "bindings", "looknfeel", "autostart")
NOTE = "MIGRATED-FROM-CONF.txt"
# Lines VeloGuard itself shipped in the personal .conf files, with their exact
# Lua equivalents (so a customized file keeps them).
KNOWN = {
    "windowrule = match:class (Alacritty|kitty|foot), scroll_touchpad 1.5":
        'hl.window_rule({ name = "terminal-touchpad-scroll", match = { class = "(Alacritty|kitty|foot)" }, scroll_touchpad = 1.5 })',
}


def lua_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def lua_val(v):
    v = v.strip()
    if re.fullmatch(r"-?\d+", v):
        return v
    if re.fullmatch(r"-?\d*\.\d+", v):
        return v
    if v in ("true", "yes", "on"):
        return "true"
    if v in ("false", "no", "off"):
        return "false"
    return lua_str(v)


def keys(mods, key):
    mods = [m for m in re.split(r"[\s_]+", mods.strip()) if m]
    return " + ".join(mods + [key.strip()])


def strip(line):
    return re.sub(r"\s+#.*$", "", line).strip() if not line.lstrip().startswith("#") else ""


def convert(text):
    """hyprlang subset -> (lua lines, untranslated original lines)."""
    out, todo, cfg, stack = [], [], {}, []
    for raw in text.splitlines():
        line = strip(raw)
        if not line:
            continue
        m = re.fullmatch(r"([\w.:-]+)\s*\{", line)
        if m:
            stack.append(m.group(1)); continue
        if line == "}":
            if stack: stack.pop()
            continue
        if line in KNOWN:
            out.append(KNOWN[line]); continue
        m = re.fullmatch(r"([\w.:-]+)\s*=\s*(.*)", line)
        if not m:
            todo.append(raw.strip()); continue
        k, v = m.group(1), m.group(2).strip()
        if stack:
            if stack[0] in ("input", "general", "decoration", "misc", "cursor") and "." not in k and "$" not in v:
                node = cfg
                for part in stack:
                    node = node.setdefault(part, {})
                node[k] = lua_val(v)
            else:
                todo.append(raw.strip())
            continue
        if k == "monitor":
            f = [x.strip() for x in v.split(",")]
            if len(f) == 4:
                out.append("hl.monitor({ output = %s, mode = %s, position = %s, scale = %s })"
                           % (lua_str(f[0]), lua_str(f[1]), lua_str(f[2]), lua_val(f[3])))
            else:
                todo.append(raw.strip())
        elif k in ("bind", "bindl", "bindr", "binde", "bindel", "bindle"):
            f = [x.strip() for x in v.split(",", 3)]
            if len(f) == 4 and f[2] == "exec" and "$" not in f[0] + f[1]:
                opts = []
                if "l" in k[4:]: opts.append("locked = true")
                if "e" in k[4:]: opts.append("repeating = true")
                if "r" in k[4:]: opts.append("release = true")
                out.append("hl.bind(%s, hl.dsp.exec_cmd(%s)%s)" % (lua_str(keys(f[0], f[1])), lua_str(f[3]),
                           (", { " + ", ".join(opts) + " }") if opts else ""))
            else:
                todo.append(raw.strip())
        elif k == "unbind":
            f = [x.strip() for x in v.split(",")]
            if len(f) == 2 and "$" not in v:
                out.append("hl.unbind(%s)" % lua_str(keys(f[0], f[1])))
            else:
                todo.append(raw.strip())
        elif k == "exec-once":
            out.append("hl.on(\"hyprland.start\", function() hl.exec_cmd(%s) end)" % lua_str(v))
        else:
            todo.append(raw.strip())

    def emit(d, ind):
        lines = []
        for k, v in d.items():
            if isinstance(v, dict):
                lines.append("%s%s = {" % (ind, k)); lines += emit(v, ind + "  "); lines.append("%s}," % ind)
            else:
                lines.append("%s%s = %s," % (ind, k, v))
        return lines
    if cfg:
        out = ["hl.config({"] + emit(cfg, "  ") + ["})"] + out
    return out, todo


def stock(name):
    """The shipped skel .conf a personal file started from (comments ignored)."""
    p = os.path.join("/usr/share/veloguard/desktop/hypr/legacy-skel", name + ".conf")
    try:
        return [l for l in (strip(x) for x in open(p)) if l]
    except OSError:
        return None


def migrate(user):
    pw = pwd.getpwnam(user)
    hypr = os.path.join(pw.pw_dir, ".config", "hypr")
    conf, lua = os.path.join(hypr, "hyprland.conf"), os.path.join(hypr, "hyprland.lua")
    try:
        if MARK not in open(conf).read():
            return f"{user}: not a VeloGuard hyprland.conf — left alone"
    except OSError:
        return f"{user}: no hyprland.conf — nothing to migrate"
    if os.path.exists(lua) and "autogenerated = true" not in open(lua).read():
        return f"{user}: already has its own hyprland.lua — left alone"
    if not os.path.isfile(os.path.join(SKEL, "hyprland.lua")):
        return f"{user}: {SKEL}/hyprland.lua missing — install the current VeloGuardOS desktop files first"

    def own(path):   # runs as the user (see run_as): no chown needed
        os.chmod(path, 0o644)

    if os.path.exists(lua):
        shutil.move(lua, lua + ".autogenerated")
    notes = []
    for name in PERSONAL:
        dst = os.path.join(hypr, name + ".lua")
        if os.path.exists(dst):
            continue
        shutil.copyfile(os.path.join(SKEL, name + ".lua"), dst)
        src = os.path.join(hypr, name + ".conf")
        try:
            text = open(src).read()
        except OSError:
            own(dst); continue
        meaningful = [l for l in (strip(x) for x in text.splitlines()) if l]
        if meaningful and meaningful != stock(name):
            got, todo = convert(text)
            with open(dst, "w") as f:   # the user's own settings replace the skel defaults
                f.write("-- Converted from %s.conf by veloguard-hypr-migrate (Hyprland 0.57 reads\n" % name)
                f.write("-- only Lua). The original stays next to this file.\n")
                f.write("\n".join(got) + "\n")
                if todo:
                    f.write("\n-- Not converted automatically; port by hand (https://wiki.hypr.land/configuring/):\n")
                    f.write("\n".join("-- " + t for t in todo) + "\n")
            if todo:
                notes.append("%s.conf: %d line(s) to port by hand, kept as comments in %s.lua"
                             % (name, len(todo), name))
        own(dst)
    shutil.copyfile(os.path.join(SKEL, "hyprland.lua"), lua)
    # The old entry file invited personal lines at its bottom: carry them over.
    base = set(stock("hyprland") or [])
    extra = [l for l in open(conf).read().splitlines()
             if strip(l) and strip(l) not in base and not strip(l).startswith("source =")]
    if extra:
        got, todo = convert("\n".join(extra))
        with open(lua, "a") as f:
            f.write("\n-- Converted from the bottom of your hyprland.conf by veloguard-hypr-migrate:\n")
            f.write("\n".join(got) + "\n")
            if todo:
                f.write("-- Not converted automatically; port by hand:\n" + "\n".join("-- " + t for t in todo) + "\n")
        if todo:
            notes.append("hyprland.conf: %d line(s) to port by hand, kept as comments in hyprland.lua" % len(todo))
    own(lua)
    if notes:
        with open(os.path.join(hypr, NOTE), "w") as f:
            f.write("Hyprland 0.57 reads only Lua, so VeloGuardOS moved this account's config\n"
                    "from ~/.config/hypr/*.conf to *.lua. Most settings were converted; these\n"
                    "were not (the .conf originals are untouched):\n\n  " + "\n  ".join(notes) +
                    "\n\nDelete this file when done.\n")
        own(os.path.join(hypr, NOTE))
    return f"{user}: migrated to Lua" + (f" ({len(notes)} file(s) need a look: ~/.config/hypr/{NOTE})" if notes else "")


def run_as(user):
    """Migrate one account. As root (the pacman hook), never touch a user's
    files with root's rights — a symlink they planted in ~/.config/hypr would
    otherwise make root write or chown anything: fork and become the user."""
    if os.geteuid() != 0:
        try:
            print("veloguard-hypr-migrate:", migrate(user)); return 0
        except Exception as e:
            print(f"veloguard-hypr-migrate: {user}: {e}", file=sys.stderr); return 1
    pw = pwd.getpwnam(user)
    sys.stdout.flush(); sys.stderr.flush()
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([]); os.setgid(pw.pw_gid); os.setuid(pw.pw_uid)
            os.environ["HOME"] = pw.pw_dir; os.umask(0o022)
            print("veloguard-hypr-migrate:", migrate(user)); sys.stdout.flush()
            os._exit(0)
        except Exception as e:   # one broken home must not stop the others (or pacman)
            print(f"veloguard-hypr-migrate: {user}: {e}", file=sys.stderr); sys.stderr.flush()
            os._exit(1)
    return 1 if os.waitpid(pid, 0)[1] else 0


def main(argv):
    if argv[:1] == ["--all"]:
        users = [p.pw_name for p in pwd.getpwall()
                 if p.pw_dir.startswith("/home/") and os.path.isdir(p.pw_dir)]
    else:
        users = argv or [pwd.getpwuid(os.getuid()).pw_name]
    rc = 0
    for u in users:
        rc |= run_as(u)
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
