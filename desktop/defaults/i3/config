# VeloGuardOS — i3, riced like the default VeloGuard Hyprland desktop: the
# same top bar (polybar: the guard, AI usage, Wi-Fi, Bluetooth, volume,
# brightness, power profile, battery, tray, notifications, the quick panel),
# the same quick panel (Quickshell), menus (rofi), notifications (dunst),
# Frost colours. i3's own keys are kept (on Super); VeloGuard's are added —
# see "VeloGuard" below.
#
# This file is yours: edit freely ($mod+Shift+c reloads). Colours come from
# the active VeloGuard theme (`veloguard-theme set …` rewrites the include).
# Based on i3's default config (BSD-3-Clause).

set $mod Mod4

font pango:JetBrainsMono Nerd Font 10

# The VeloGuard session: polybar, dunst, the quick panel, Albert, the
# compositor, lock on idle/suspend, wallpaper, polkit, XDG autostart (VPN
# auto-protect, input methods), first-boot setup.
exec --no-startup-id veloguard-desktop-autostart i3

# Frost: no gaps, a 1-pixel dark-blue edge, no title bars
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders none
gaps inner 0
gaps outer 0
include ~/.config/veloguard/generated/i3-colors.conf

floating_modifier $mod
tiling_drag modifier titlebar

for_window [class="(?i)albert"] floating enable, border none
for_window [class="(?i)pavucontrol"] floating enable
for_window [class="(?i)blueman-manager"] floating enable
for_window [class="(?i)zenity"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
# the quick panel (Quickshell)
for_window [class="(?i)quickshell"] floating enable, border none, sticky enable

# ── VeloGuard ─────────────────────────────────────────────────────────────
bindsym $mod+Shift+g exec --no-startup-id veloguard-guard-menu
bindsym $mod+Shift+v exec --no-startup-id veloguard-guard-menu vpn
bindsym $mod+Shift+a exec --no-startup-id veloguard-agent
bindsym $mod+Shift+e exec --no-startup-id veloguard-agent ask
bindsym $mod+u exec --no-startup-id veloguard-quickpanel
bindsym $mod+n exec --no-startup-id veloguard-session notifications
bindsym $mod+Shift+n exec --no-startup-id veloguard-session notifications clear
bindsym $mod+x exec --no-startup-id veloguard-powermenu
bindsym $mod+Escape exec --no-startup-id veloguard-powermenu
bindsym XF86PowerOff exec --no-startup-id veloguard-powermenu
bindsym $mod+Shift+t exec --no-startup-id veloguard-theme menu
bindsym $mod+Ctrl+space exec --no-startup-id veloguard-session layout
bindsym $mod+Ctrl+l exec --no-startup-id veloguard-session lock
bindsym $mod+b exec --no-startup-id veloguard-session bar
bindsym Mod1+space exec --no-startup-id albert toggle
bindsym Print exec --no-startup-id veloguard-session screenshot area
bindsym $mod+Print exec --no-startup-id veloguard-session screenshot screen
bindsym Shift+Print exec --no-startup-id veloguard-session screenshot area --file
bindsym $mod+Shift+Print exec --no-startup-id veloguard-session screenshot screen --file
# i3's exit (its Mod+Shift+e is VeloGuard's "ask an AI agent" here)
bindsym $mod+Ctrl+Shift+e exec "i3-nagbar -t warning -m 'Exit i3? This ends your session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Volume, microphone and brightness, with the level shown as a pop-up
bindsym XF86AudioRaiseVolume exec --no-startup-id veloguard-osd volume up
bindsym XF86AudioLowerVolume exec --no-startup-id veloguard-osd volume down
bindsym XF86AudioMute exec --no-startup-id veloguard-osd volume mute
bindsym XF86AudioMicMute exec --no-startup-id veloguard-osd mic mute
bindsym XF86MonBrightnessUp exec --no-startup-id veloguard-osd brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id veloguard-osd brightness down
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ── i3's own (its defaults, on Super) ────────────────────────────────────
set $up l
set $down k
set $left j
set $right semicolon

bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

mode "resize" {
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
