/* VeloGuardOS — rofi (the menus on i3 and Xfce: guard, VPN, Wi-Fi,
 * Bluetooth, power, theme, agents; and the app launcher on i3). Same look as
 * the wofi menus on Hyprland: Frost glass, the active theme's colours
 * (generated by veloguard-theme into ~/.config/veloguard/generated). */
@import "~/.config/veloguard/generated/rofi-colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @vg-fg;
}
window {
    background-color: @vg-bg;
    border: 1px;
    border-color: @vg-accent;
    border-radius: 0;
    width: 420px;
    padding: 8px;
    location: north;
    y-offset: 40px;
}
mainbox { spacing: 8px; }
inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 6px 8px;
    background-color: rgba(59, 91, 217, 0.18);
}
prompt { text-color: @vg-accent2; }
entry { placeholder: ""; cursor: text; }
listview { lines: 10; columns: 1; scrollbar: false; fixed-height: false; dynamic: true; spacing: 2px; }
element { padding: 5px 8px; spacing: 8px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @vg-accent; text-color: #ffffff; }
element-text { text-color: inherit; highlight: bold #ffffff; vertical-align: 0.5; }
element-icon { size: 1.2em; }
message { padding: 6px 8px; }
textbox { text-color: @vg-muted; }
