[Unit]
Description=VeloGuardOS zero-trust firewall (inbound default-deny + the guard's blocklist)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/veloguard/provision/veloguard-firewall start
ExecReload=/opt/veloguard/provision/veloguard-firewall reload
ExecStop=/opt/veloguard/provision/veloguard-firewall stop
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
