/*
 * VeloGuardOS installer — the default VeloGuard theme
 * (desktop/themes/veloguard: navy #13203a, deep #0d1729, text #e6edf7,
 * cyan #33ccff, guard green #00ff99). Same palette as theme.js (QML pages)
 * and branding.desc (sidebar) — keep the three in step.
 *
 * Calamares 3.4 loads stylesheet.qss from the branding directory and applies
 * it to the whole widget UI. QML pages don't see it; they use theme.js.
 */

/* ── base: every widget page sits on the theme's navy ─────────────────── */
QWidget {
    background-color: #13203a;
    color: #e6edf7;
    selection-background-color: #33ccff;
    selection-color: #0d1729;
}
QLabel, QCheckBox, QRadioButton, QGroupBox { background: transparent; }
QGroupBox { border: 1px solid #2b3b5c; border-radius: 6px; margin-top: 1.2em; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #33ccff; }
QToolTip { background-color: #0d1729; color: #e6edf7; border: 1px solid #33ccff; padding: 4px; }

/* ── sidebar (colours also set in branding.desc) ──────────────────────── */
#sidebarApp, #sidebarMenuApp, #logoApp { background-color: #0d1729; }

/* ── buttons: navigation (Back / Next / Cancel) and in-page ───────────── */
QPushButton, QToolButton {
    background-color: #0d1729;
    color: #e6edf7;
    border: 1px solid #2b3b5c;
    border-radius: 6px;
    padding: 6px 16px;
}
QPushButton:hover, QToolButton:hover { background-color: #1b2c4f; border-color: #33ccff; }
QPushButton:pressed, QToolButton:pressed,
QPushButton:checked, QToolButton:checked { background-color: #33ccff; color: #0d1729; border-color: #33ccff; }
QPushButton:focus { border-color: #33ccff; }
QPushButton:disabled, QToolButton:disabled { color: #4a5568; border-color: #1b2c4f; }
/* Next is the primary action: the cyan accent, like the theme's active border */
QPushButton#view-button-next { background-color: #33ccff; color: #0d1729; border-color: #33ccff; font-weight: bold; }
QPushButton#view-button-next:hover { background-color: #66d9ff; border-color: #66d9ff; }
QPushButton#view-button-next:disabled { background-color: #1b2c4f; color: #4a5568; border-color: #1b2c4f; }

/* ── inputs, lists, trees (locale, keyboard, users, partition pages) ──── */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit, QTextBrowser,
QListView, QListWidget, QTreeView, QTreeWidget, QTableView {
    background-color: #0d1729;
    color: #e6edf7;
    border: 1px solid #2b3b5c;
    border-radius: 4px;
    padding: 2px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #33ccff; }
QLineEdit:disabled, QComboBox:disabled { color: #4a5568; }
QComboBox QAbstractItemView {
    background-color: #0d1729;
    color: #e6edf7;
    border: 1px solid #33ccff;
    selection-background-color: #33ccff;
    selection-color: #0d1729;
}
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background-color: #33ccff; color: #0d1729; }
QListView::item:hover, QTreeView::item:hover { background-color: #1b2c4f; }
QHeaderView::section { background-color: #0d1729; color: #8b98ad; border: none; border-bottom: 1px solid #2b3b5c; padding: 4px 6px; }

/* ── progress (the install page) ──────────────────────────────────────── */
QProgressBar {
    background-color: #0d1729;
    color: #e6edf7;
    border: 1px solid #2b3b5c;
    border-radius: 4px;
    text-align: center;
    min-height: 14px;
}
QProgressBar::chunk { background-color: #33ccff; border-radius: 3px; }

/* ── scrollbars: slim, theme-coloured ─────────────────────────────────── */
QScrollBar:vertical { background: #0d1729; width: 10px; margin: 0; }
QScrollBar:horizontal { background: #0d1729; height: 10px; margin: 0; }
QScrollBar::handle { background: #2b3b5c; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #33ccff; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
