# VeloGuardOS — base/system fragment: what a STANDALONE DESKTOP actually needs
# beyond drivers. This is the glue: boot, systemd's kernel prerequisites,
# sandboxing primitives for universal package formats, the netfilter/nftables
# stack VeloGuard's own guard drives, WireGuard (the built-in VPN), and laptop
# power management.
#
# Merge it FIRST (before desktop + hardware):
#   ./scripts/kconfig/merge_config.sh -m arch/x86/configs/x86_64_defconfig \
#       veloguard/kernel/veloguardos-base.config \
#       veloguard/kernel/veloguardos-desktop.config \
#       veloguard/kernel/veloguardos-hardware.config
#   make olddefconfig

# ===========================================================================
# Boot / firmware / initramfs — UEFI machines + an initramfs to load modules.
# ===========================================================================
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# BINFMT_MISC: lets the system run foreign binaries (Wine, some installers).
CONFIG_BINFMT_MISC=m

# ===========================================================================
# Firmware + module loading — MUST match how Arch ships its files.
# Arch's linux-firmware-* packages install EVERY blob zstd-compressed
# (intel/iwlwifi/*.ucode.zst, amdgpu/*.bin.zst, rtw88/*.bin.zst …). Without
# FW_LOADER_COMPRESS the kernel only asks for the uncompressed name, so every
# firmware request fails: no Intel/Realtek/MediaTek Wi-Fi, no Bluetooth, no
# amdgpu display, no GuC/HuC/DMC on Intel graphics, no SOF audio DSP.
# (x86_64_defconfig leaves this off — it was the "kernel is broken" root cause.)
# ===========================================================================
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
# Modules zstd-compressed like Arch's own kernel (PKGBUILD's ZSTD_CLEVEL is a
# no-op without it); DKMS reads this from the headers package and matches it.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# /proc/config.gz — users, Waydroid, Docker's check-config and bug reports can
# see exactly what this kernel was built with.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# `uname -r` = 7.x.y-veloguard: our modules live in their own
# /usr/lib/modules/<ver>-veloguard and can never collide with Arch's `linux`,
# and the updater can tell which kernel is actually running.
CONFIG_LOCALVERSION="-veloguard"

# ===========================================================================
# systemd's kernel requirements (a desktop won't boot cleanly without these).
# ===========================================================================
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_CONFIGFS_FS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
# PSI: pressure-stall info — systemd-oomd refuses to start without it.
CONFIG_PSI=y
# BPF JIT: systemd's cgroup device/IP filters and the guard run as native code
# instead of the interpreter; ALWAYS_ON removes the interpreter (Spectre v2).
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
# Socket diagnostics — without INET_DIAG `ss -tulpn` lists nothing.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y

# ===========================================================================
# Namespaces + cgroups — required by systemd AND by every app sandbox
# (Flatpak/bubblewrap, AppImage, containers). USER_NS is the linchpin.
# ===========================================================================
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ===========================================================================
# Sandbox filesystems — AppImage (FUSE+squashfs), Snap (squashfs),
# Flatpak/containers (overlayfs). FUSE/SQUASHFS/OVERLAY also set in hardware;
# here we add the squashfs decompressors AppImages/snaps actually use.
# ===========================================================================
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=m

# ===========================================================================
# Netfilter / nftables — the kernel side of VeloGuard's guard + the firewall.
# Without NF_TABLES the `nft` executor has nothing to talk to.
# ===========================================================================
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LOG=m
# XTABLES ends up built-in (selected by iptables compat in the base defconfig).
CONFIG_NETFILTER_XTABLES=y
# ADVANCED unlocks the rest; without it NF_CONNTRACK_MARK silently vanishes.
CONFIG_NETFILTER_ADVANCED=y
# wg-quick's full-tunnel rules (AllowedIPs = 0.0.0.0/0, ::/0 — what every
# Proton/Mullvad/Nord/Surfshark config uses) need ALL of: `fib saddr type`
# (NFT_FIB_*), `ct mark` / `meta mark set ct mark` (NF_CONNTRACK_MARK), and
# fwmark policy routing for BOTH families (IP[V6]_MULTIPLE_TABLES). Missing any
# one and `wg-quick up` aborts — the built-in VPN would be dead on arrival.
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# Rate/quota/connlimit expressions for guard rules; REDIR for the honeypot
# (`tcp dport 22 redirect to :2222`); NETDEV for ingress filtering.
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_REDIR=m
CONFIG_NF_TABLES_NETDEV=y
# Arch's iptables IS iptables-nft: Docker/Podman/libvirt rules go through
# NFT_COMPAT + the xt matches they emit.
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m

# ===========================================================================
# Android containers (Waydroid) — binder IPC + binderfs. ASHMEM is gone in
# modern kernels; Waydroid uses binderfs + memfd instead.
# ===========================================================================
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ===========================================================================
# Windows app compatibility — the KERNEL side of running Windows software.
# Wine/Proton themselves are userspace (a ~3M-line Windows reimplementation);
# the kernel's job is the bridge: binfmt_misc (above) auto-launches .exe via
# Wine, and NTSYNC provides Windows NT sync primitives (mutex/sem/event) in the
# kernel so Wine/Proton stop emulating them slowly in userspace — big speedups.
# This is the upstream, legitimate "Windows compat in the kernel".
# ===========================================================================
CONFIG_NTSYNC=y

# ===========================================================================
# VPN + virtual networking — WireGuard is your "built-in VPN"; TUN powers
# almost every other VPN client; veth/bridge/vlan round out connectivity.
# ===========================================================================
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m

# ===========================================================================
# Disk encryption crypto (LUKS via dm-crypt, already a module in hardware).
# cryptsetup does LUKS2 keyslot crypto through AF_ALG (USER_API_SKCIPHER/AEAD)
# — the installer offers encryption, so these must be present at unlock time.
# ===========================================================================
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_DM_SNAPSHOT=m
# TPM 2.0: systemd-cryptenroll --tpm2-device, measured boot, hwrng.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y

# ===========================================================================
# Memory — compressed swap in RAM (zram-generator) / zswap, and THP for the
# local AI plane (llama.cpp/Ollama weights love huge pages).
# ===========================================================================
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# ===========================================================================
# Virtualization — KVM backs the guard's strongest isolation tier (vlayer
# "vm": Firecracker/cloud-hypervisor microVMs) plus virt-manager/Boxes.
# ===========================================================================
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
# vsock: host<->microVM control channel (Firecracker's agent socket).
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_VHOST_VSOCK=m

# ===========================================================================
# Hardening (it's GuardOS) — the cheap, Arch-parity kernel self-protection set.
# LOCKDOWN_LSM is built but inert until booted with lockdown=integrity (it
# selects MODULE_SIG: in-tree modules get signed with a throwaway per-build key;
# DKMS modules load unsigned with a taint unless lockdown is switched on).
# ===========================================================================
# TIOCSTI lets any process push keystrokes into a terminal it shares — the
# classic sudo/su session-escape. Arch disables it too.
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y

# ===========================================================================
# Power management — suspend/resume, CPU scaling, laptop backlight/battery.
# ===========================================================================
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_AC=m
CONFIG_ACPI_VIDEO=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# defconfig caps at 64 CPUs — a 7950X3D/Threadripper would lose threads.
CONFIG_NR_CPUS=320
