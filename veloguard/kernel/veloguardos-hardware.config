# VeloGuardOS — broad hardware-enablement fragment ("works for everyone").
#
# Goal: support as much hardware as practical, OUT OF THE BOX, without drivers
# stepping on each other. The trick is simple and is how every real distro does
# it: build drivers as MODULES (=m). udev then auto-loads only the module that
# matches the hardware actually present — an Intel box never loads the AMD GPU
# driver, etc. Only the few things needed early (DRM core, root storage, evdev,
# VM transport) are built in (=y).
#
# Drivers need FIRMWARE to actually work — that's userspace; see
# ../provision/install-firmware-codecs.sh (linux-firmware, microcode, codecs).
#
# Merge (run from the kernel tree root), desktop first, hardware last:
#   ./scripts/kconfig/merge_config.sh -m arch/x86/configs/x86_64_defconfig \
#       veloguard/kernel/veloguardos-desktop.config \
#       veloguard/kernel/veloguardos-hardware.config
#   make olddefconfig          # final dependency resolution (needs bison/flex)
#
# Want LITERALLY every driver? `make allmodconfig` builds them all as modules —
# this fragment is the curated, mainstream subset (smaller, no staging/debug).

# ===========================================================================
# CPU microcode — applied early; the blobs come from intel-ucode/amd-ucode.
# (Intel & AMD are folded into one symbol in this kernel.)
# ===========================================================================
CONFIG_MICROCODE=y

# ===========================================================================
# GPU / DRM — every vendor, as modules (matching one loads). Core is built in.
# ===========================================================================
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Intel
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
# AMD (incl. old GCN southern/sea islands + the Display Core)
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m
# ROCm compute for the local AI plane (ollama-rocm / llama.cpp HIP) — KFD.
CONFIG_HSA_AMD=y
CONFIG_DRM_AMDGPU_USERPTR=y
# NVIDIA (open driver; proprietary CUDA stack layered later in userspace)
CONFIG_DRM_NOUVEAU=m
# NPUs — Intel Core Ultra (IVPU) and AMD Ryzen AI (XDNA) for the AI plane.
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=m
CONFIG_DRM_ACCEL_AMDXDNA=m
# Draw kernel panics on screen instead of freezing a graphical session black.
CONFIG_DRM_PANIC=y
# Server BMC / virtual / QEMU display engines
CONFIG_DRM_AST=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_HYPERV=m
CONFIG_DRM_VBOXVIDEO=m

# ===========================================================================
# Wired networking — common desktop/laptop/server NICs as modules.
# ===========================================================================
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_R8169=m
CONFIG_TIGON3=m
CONFIG_ATL1C=m
CONFIG_ALX=m
CONFIG_SKY2=m
CONFIG_VMXNET3=m
CONFIG_VIRTIO_NET=m
# USB/USB-C Ethernet + phone tethering — docks (RTL8153/AX88179), CDC-ECM/NCM
# adapters, Android RNDIS, iPhone hotspot over cable.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m

# ===========================================================================
# Wi-Fi — needs the 802.11 stack + per-vendor menus turned on first.
# ===========================================================================
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_BROADCOM=y
# Intel (MLD = the Wi-Fi 7 op-mode: BE200/BE201/BE202 don't work without it)
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_IWLMLD=m
# Atheros / Qualcomm (ATH12K = WCN7850 Wi-Fi 7 in current Snapdragon/AMD laptops)
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# Realtek PCIe — 8822CE is the shipped test laptop's own card (see
# iso/airootfs/etc/modprobe.d/rtw88-veloguard.conf); 8852BE/CE are the most
# common budget-laptop cards of the last four years.
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852BTE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
# Realtek USB dongles (vendor 0bda — the udev keep-awake rule targets these)
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
# MediaTek (MT7925 = Wi-Fi 7 in many 2024+ laptops) + USB dongles
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_MT7915E=m
CONFIG_MT7921U=m
CONFIG_MT7925U=m
CONFIG_MT7601U=m
CONFIG_MT76x2U=m
# Broadcom — brcmfmac is useless without a bus backend; b43 covers the older
# chips (BCM4311/4312/4321…) so they don't need the proprietary wl at all.
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_SSB=m
CONFIG_BCMA=m
CONFIG_B43=m
CONFIG_B43_BCMA=y
CONFIG_B43_SSB=y

# ===========================================================================
# Bluetooth
# ===========================================================================
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_INTEL_PCIE=m
CONFIG_BT_HCIUART=m
CONFIG_RFKILL=m

# ===========================================================================
# Storage — NVMe, SATA/AHCI, USB, SD/MMC, RAID/LVM, VM, card readers, USB4.
# ===========================================================================
CONFIG_BLK_DEV_NVME=m
# Intel VMD (RST "RAID/VMD" mode, the factory default on many Dell/HP/Lenovo
# 11th-gen+ laptops): NVMe sits BEHIND it — without VMD the root disk simply
# doesn't exist and boot drops to an emergency shell. Built in: no initramfs
# autodetect corner case can lose it.
CONFIG_VMD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=m
CONFIG_ATA_PIIX=m
CONFIG_SATA_SIL=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_VIRTIO_BLK=m
CONFIG_SCSI_VIRTIO=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_PVSCSI=m
CONFIG_USB4=m

# ===========================================================================
# USB host controllers + common gadgets
# ===========================================================================
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
# Renesas uPD720201/2 xHCI (common on add-in cards/older laptops) needs its
# firmware-loading glue module.
CONFIG_USB_XHCI_PCI_RENESAS=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
# Microcontroller USB-serial bridges: CP210x (ESP32), FTDI, CH340/CH341 (the
# chip on nearly every Arduino Nano/Uno clone), PL2303.
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
# USB-C: UCSI reports PD/role/alt-mode state (charging, DP-alt docks).
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m

# ===========================================================================
# Input / HID — keyboards, mice, touchpads (incl. modern I2C-HID), tablets.
# ===========================================================================
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_MOUSEDEV=m
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_APPLE=m
# LED class needed by HID_LOGITECH and the Dell laptop driver below.
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_WACOM=m
# Game controllers (install-gaming.sh provisions Steam/Proton): Xbox, DualShock
# 4 / DualSense, Switch Pro/Joy-Con, Steam Controller/Deck.
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m
# I2C-HID is only the protocol — the touchpad still needs the I2C controller
# (Synopsys DesignWare, exposed via Intel LPSS on Intel / ACPI on AMD) and the
# GPIO controller that delivers its interrupt (pinctrl). Without these, the
# touchpad on essentially every laptop since ~2016 is dead.
# x86_64_defconfig has NO GPIO/pinctrl subsystem at all — enable the gates
# first, or every PINCTRL_* below is silently dropped. X86_INTEL_LPSS and
# X86_AMD_PLATFORM_DEVICE provide the clocks the DesignWare I2C IP runs on.
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_METEORPOINT=m
# Lunar / Panther / Nova Lake have no per-SoC driver — the generic one.
CONFIG_PINCTRL_INTEL_PLATFORM=m
# Sensor hubs — 2-in-1 rotation, lid/tablet-mode, ambient light.
CONFIG_HID_SENSOR_HUB=m
CONFIG_INTEL_ISH_HID=m
CONFIG_AMD_SFH_HID=m

# ===========================================================================
# Audio — HDA codecs + USB audio + SOF (modern Intel/AMD laptop DSP audio).
# ===========================================================================
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
# The TOPLEVEL switches alone build nothing: SOF needs PCI enumeration plus a
# per-platform driver and a machine driver. snd-intel-dspcfg routes any laptop
# with digital mics / SoundWire to SOF — with no SOF driver those machines get
# no internal mic, and SoundWire-only ones (many 2022+ Dell/Lenovo/HP) get no
# audio at all. Firmware comes from sof-firmware (in the archiso base set).
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_COMETLAKE=m
CONFIG_SND_SOC_SOF_ICELAKE=m
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_PANTHERLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SOUNDWIRE=m
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
# The SoundWire machine driver also needs SPI (amp codecs) and the long card
# names UCM matches on.
CONFIG_SPI=y
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
# AMD: SOF platforms + the ACP DMIC paths (Renoir / Yellow Carp / Pink Sardine
# — the built-in mic on Ryzen 4000-7000 laptops).
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_RENOIR=m
CONFIG_SND_SOC_SOF_AMD_REMBRANDT=m
CONFIG_SND_SOC_SOF_AMD_ACP63=m
CONFIG_SND_SOC_SOF_AMD_ACP70=m
CONFIG_SND_SOC_AMD_ACP=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_RENOIR_MACH=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m

# ===========================================================================
# Cameras — UVC webcams (the vast majority of laptops/USB cams).
# ===========================================================================
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

# ===========================================================================
# Filesystems — mount anyone's disk: Linux, Windows, removable, network.
# ===========================================================================
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
# POSIX ACLs on every installer-offered root fs (ext4 has them via defconfig):
# journald grants wheel/adm read access to /var/log/journal through ACLs and
# systemd-tmpfiles/logind apply them — without these, btrfs/xfs roots log
# errors and users can't read their own journal.
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NFS_FS=m
CONFIG_CIFS=m
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ===========================================================================
# Run in ANY VM / cloud out of the box — virtio, Hyper-V, VMware.
# ===========================================================================
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HYPERV_BALLOON=m
CONFIG_HYPERV_UTILS=m
CONFIG_VMWARE_BALLOON=m
# VirtualBox guest (shared folders, clipboard via the guest additions daemon)
# — the whole virt/ menu is gated.
CONFIG_VIRT_DRIVERS=y
CONFIG_VBOXGUEST=m
CONFIG_VBOXSF_FS=m

# ===========================================================================
# Laptop platform integration — Fn keys, rfkill, sensors, battery quirks.
# ===========================================================================
CONFIG_ACPI_WMI=m
CONFIG_THINKPAD_ACPI=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
# The whole Dell submenu is gated behind this menuconfig — without it every
# Dell symbol below is skipped.
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
# DCDBAS is the SMM backend DELL_SMBIOS needs; without a backend the whole
# Dell stack silently drops out.
CONFIG_DCDBAS=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_SMBIOS_SMM=y
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_WMI=m
CONFIG_IDEAPAD_LAPTOP=m
CONFIG_LENOVO_WMI_HOTKEY_UTILITIES=m
# HP's whole submenu is gated like Dell's.
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=m
CONFIG_ACER_WMI=m
CONFIG_MSI_WMI=m
# intel-hid / intel-vbtn deliver the power button, Fn hotkeys and the
# tablet-mode switch on modern-standby Intel laptops — without them the power
# button can be a no-op.
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
# Suspend that actually reaches low power: AMD PMC (s2idle on every Ryzen
# laptop) and Intel PMC core (S0ix residency/debug).
CONFIG_AMD_PMC=m
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
# Thermals/sensors — thermald, waybar's temperature module, fan curves.
CONFIG_INT340X_THERMAL=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_HWMON=y
