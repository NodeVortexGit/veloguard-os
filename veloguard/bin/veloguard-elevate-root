#!/usr/bin/env python3
"""veloguard-elevate-root — run ONE command as root after the desktop user
clicks Approve. The root half of veloguard-elevate (what AI agents' `sudo`
becomes): started through pkexec, which polkit lets an active local admin do
without a password (49-veloguard-elevate.rules) — the user chose a click, not a
password, so THIS program is the approval and has to be one the requesting
agent can't answer for itself:

  * the dialog runs as ROOT (the agent, running as the user, can't signal,
    trace or reconfigure it) with a clean environment — no user GTK/CSS
    config, so the command text can't be hidden or restyled;
  * it reaches the screen over a Wayland connection this program opens and
    verifies itself: the socket's peer must be the session's REAL compositor
    (a known root-owned binary, running as the user, holding the input
    devices logind hands only to the session controller). A fake or nested
    compositor in the user's runtime dir — which the user's processes can
    write — is refused, so an agent can't route the dialog somewhere it
    answers. The verified socket is handed to the dialog (WAYLAND_SOCKET),
    no path lookup in between;
  * Deny is the default button, 120 s without an answer is a Deny, one dialog
    at a time, and every request — approved or not — is in the audit log;
  * defended by design (guardd/cmdguard.py, the rules the Claude Code plugin
    applies too): a command that would switch off or rewrite the guard itself
    — its services, firewall table, files, audit log — or one that malware
    typically runs (a script piped from the internet, persistence, disk
    wipes) is shown with the warning in red. The person decides; the guard
    never decides for them (2026-11-15: "everything that can be restricted,
    I should have the option to approve or deny").

Residual risk (accepted with "no password"): any Wayland client may create a
virtual keyboard/pointer, so a process watching the screen could click Approve.
A password would close that; set it per machine by deleting the polkit rule.

A TIME-LIMITED GRANT (`veloguard-elevate --grant 3h`): the person approves once
that ONE running agent may run root commands without asking, for a while —
to work while they're away. It is pinned to that agent's process (pid + start
time, found among the requester's ancestors) — any other program, even one
running as the same user, still gets the dialog — kept in /run (gone on
reboot), at most 4 h, revocable (`--revoke`), and every command it covers is
audited as "approved-by-grant". It lets the agent update VeloGuard's own files
(maintenance); it never lets it switch the guard off (services, firewall
table, audit log) unasked: those always get the dialog, grant or not.

WHO IS ASKING is read from the process tree (guardd/agentid.py), not taken
from --agent: the dialog names the nearest AI agent above this request — its
product and version, process, start time, working folder, and whether it
asked through its shell's `sudo` or the VeloGuard MCP server. --agent is only
what the requester calls itself; when it doesn't match, the dialog says so.
No known agent above it → the dialog names the exact program instead.

  veloguard-elevate-root --agent NAME --cwd DIR [--reason TEXT] [--timeout SECS]
                         [--report] -- COMMAND [ARGS...]                (via pkexec)
  veloguard-elevate-root --agent NAME [--reason TEXT] [--report] --grant 90m|2h|1h30m
  veloguard-elevate-root --revoke | --grant-status [--json]
--reason: the agent's own words, shown as such. --timeout: root stops the
command after SECS (exit 124). --report: one "VELOGUARD-ELEVATE {json}" line
on stderr with the decision, for the MCP server.
Exit: the command's own status; 1 = denied / no desktop to ask on; 2 = usage;
124 = stopped at --timeout.
"""
from __future__ import annotations

import fcntl
import glob
import html
import json
import os
import pwd
import re
import shlex
import socket
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent          # /opt/veloguard
COMPOSITORS = {
    "/usr/bin/Hyprland", "/usr/bin/hyprland", "/usr/bin/niri",
    "/usr/bin/gnome-shell", "/usr/bin/kwin_wayland", "/usr/bin/cosmic-comp",
    "/usr/bin/sway", "/usr/bin/labwc", "/usr/bin/wayfire", "/usr/bin/river",
}
INPUT_DEV = re.compile(r"^/dev/input/event\d+$")
MAX_SHOWN = 1500          # longer than this can't be read in a dialog → denied
TIMEOUT = 120
LOCK = "/run/veloguard-elevate.lock"
GRANT = "/run/veloguard/elevate-grant.json"
GRANT_STATUS = "/run/veloguard-grant.status"   # world-readable: expiry + agent name, for the bar
GRANT_INFO = "/run/veloguard-grant.json"       # world-readable: which process holds it (MCP: "covers me?")
MAX_GRANT = 4 * 3600
MAX_TIMEOUT = 6 * 3600
REASON_MAX = 300
SCRIPT_MAX = 256 * 1024
INTERPRETERS = re.compile(r"^(ba|z|da|k)?sh$|^python3?(\.\d+)?$|^perl$|^env$")
AGENT_RE = re.compile(r"^[A-Za-z0-9 ._+-]{1,40}$")
REPORT = False


def report(decision: str, how: str, **extra) -> None:
    """The decision, machine-readable, for the MCP server (--report)."""
    if REPORT:
        print("VELOGUARD-ELEVATE " + json.dumps({"decision": decision, "how": how, **extra}),
              file=sys.stderr, flush=True)


def die(msg: str, code: int = 1, decision: str = "denied") -> None:
    report("usage" if code == 2 and decision == "denied" else decision, msg)
    print(f"veloguard-elevate: {msg}", file=sys.stderr)
    sys.exit(code)


def audit(entry: dict) -> None:
    try:
        sys.path.insert(0, str(HERE))
        from guardd.audit import record
        record({"control": "elevate", **entry})
    except Exception as e:  # the decision stands even if the log can't be written
        print(f"veloguard-elevate: audit log not written ({e})", file=sys.stderr)


def parse(argv: list[str]) -> dict:
    """Options before `--` (or before --grant/--revoke/--grant-status)."""
    global REPORT
    o = {"agent": "a program", "cwd": "/", "reason": "", "timeout": 0, "cmd": None, "mode": "run",
         "grant": "", "json": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        val = argv[i + 1] if i + 1 < len(argv) else None
        if a in ("--agent", "--cwd", "--reason", "--timeout", "--grant") and val is not None:
            if a == "--timeout":
                if not val.isdigit():
                    die("--timeout takes seconds", 2)
                o["timeout"] = min(int(val), MAX_TIMEOUT)
            elif a == "--grant":
                o["mode"], o["grant"] = "grant", val
            else:
                o[a[2:]] = val
            i += 2
        elif a in ("--revoke", "--grant-status"):
            o["mode"], i = a[2:], i + 1
        elif a == "--json":
            o["json"], i = True, i + 1
        elif a == "--report":
            REPORT, i = True, i + 1
        elif a == "--" and o["mode"] == "run":
            o["cmd"] = argv[i + 1:]
            return o
        else:
            break
    if o["mode"] != "run" and i == len(argv):
        return o
    die("usage: veloguard-elevate-root --agent NAME --cwd DIR [--reason TEXT] [--timeout SECS] "
        "-- COMMAND [ARGS...]  |  --grant 90m  |  --revoke  |  --grant-status", 2)
    raise AssertionError


def clean_reason(text: str) -> str:
    """The agent's stated reason: one line, printable, short."""
    t = re.sub(r"[\x00-\x1f\x7f]+", " ", text or "")
    t = re.sub(r"\s+", " ", t).strip()
    return t if len(t) <= REASON_MAX else t[:REASON_MAX] + " …"


def _agentid():
    sys.path.insert(0, str(HERE))
    from guardd import agentid
    return agentid


def who_is_asking(claimed: str, uid: int) -> dict:
    """The agent (or exact program) behind this request, from the process tree."""
    try:
        return _agentid().describe(os.getppid(), claimed, uid)
    except Exception as e:  # identification failing must not hide the request
        return {"verified": False, "label": "an unidentified program", "pid": os.getppid(),
                "name": "an unidentified program", "exe": "", "via": "shell",
                "start": "", "error": str(e)}


def who_line(who: dict) -> str:
    try:
        return _agentid().one_line(who)
    except Exception:
        return f"{who.get('name')} (pid {who.get('pid')})"


def who_pango(who: dict) -> str:
    try:
        return _agentid().pango(who)
    except Exception:
        return f"<small>process {who.get('pid')}</small>"


def _span(secs: int) -> str:
    h, m = secs // 3600, secs % 3600 // 60
    return (f"{h} h" + (f" {m} min" if m else "")) if h else f"{max(m, 1)} min"


def peer(sock: socket.socket) -> tuple[int, int]:
    pid, uid, _ = struct.unpack("3i", sock.getsockopt(
        socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
    return pid, uid


def holds_input_devices(pid: int) -> bool:
    for fd in glob.glob(f"/proc/{pid}/fd/*"):
        try:
            if INPUT_DEV.match(os.readlink(fd)):
                return True
        except OSError:
            continue
    return False


def verified_compositor(uid: int) -> socket.socket | None:
    """A connection to the user's real session compositor, or None."""
    for path in sorted(glob.glob(f"/run/user/{uid}/wayland-*")):
        if path.endswith(".lock"):
            continue
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(path)
            pid, puid = peer(s)
            exe = os.readlink(f"/proc/{pid}/exe")
            if puid == uid and exe in COMPOSITORS and holds_input_devices(pid):
                return s
        except OSError:
            pass
        s.close()
    return None


def guard_verdict(cmd: list[str], cwd: str = "/") -> tuple[str, str, str]:
    """(verdict, reason, class) for the command AND, when it runs a script
    (`bash x.sh`, `python3 x.py`), for what the script says — zero trust: a
    command line that only names a script hides nothing from the guard."""
    try:
        sys.path.insert(0, str(HERE))
        from guardd import cmdguard
        worst = cmdguard.check_detail(shlex.join(cmd))
        rank = {"allow": 0, "warn": 1, "deny": 2}
        for path in _scripts(cmd, cwd):
            try:
                with open(path, "rb") as f:
                    body = f.read(SCRIPT_MAX + 1)
            except OSError:
                continue
            if len(body) > SCRIPT_MAX:
                return "warn", f"runs a script too large to check ({path})", "malware"
            for line in body.decode(errors="replace").splitlines():
                v = cmdguard.check_detail(line)
                if rank[v[0]] > rank[worst[0]] or (v[0] == worst[0] == "deny" and v[2] == "disable"):
                    worst = (v[0], f"{v[1]} (in {os.path.basename(path)})", v[2])
        return worst
    except Exception as e:          # the rules failing must not open the door
        return "warn", f"the guard couldn't check this command ({e})", "malware"


def _scripts(cmd: list[str], cwd: str) -> list[str]:
    out, i = [], 0
    while i < len(cmd) and INTERPRETERS.match(os.path.basename(cmd[i])):
        i += 1
        while i < len(cmd) and (cmd[i].startswith("-") or "=" in cmd[i]):
            if cmd[i] in ("-c", "-e"):
                return out                       # inline code: already in the command line
            i += 1
        if i < len(cmd):
            p = cmd[i] if os.path.isabs(cmd[i]) else os.path.join(cwd, cmd[i])
            if os.path.isfile(p):
                out.append(p)
                break
    return out


# --- the time-limited grant ----------------------------------------------------

def _stat(pid: int) -> tuple[int, str, int] | None:
    """(ppid, start time, uid) of a process, or None."""
    try:
        raw = open(f"/proc/{pid}/stat").read()
        fields = raw[raw.rindex(")") + 2:].split()
        uid = int(next(l.split()[1] for l in open(f"/proc/{pid}/status") if l.startswith("Uid:")))
        return int(fields[1]), fields[19], uid
    except (OSError, ValueError, StopIteration, IndexError):
        return None


def _ancestors(pid: int):
    seen = 0
    while pid > 1 and seen < 64:
        st = _stat(pid)
        if st is None:
            return
        yield pid, st
        pid, seen = st[0], seen + 1


def load_grant(uid: int) -> dict | None:
    try:
        g = json.load(open(GRANT))
    except (OSError, ValueError):
        return None
    if g.get("uid") != uid or time.time() > g.get("expires", 0):
        if time.time() > g.get("expires", 0):
            _clear_status()
        return None
    st = _stat(g["pid"])
    if st is None or st[1] != g["start"]:
        return None                                     # that agent is gone
    if not any(p == g["pid"] for p, _ in _ancestors(os.getppid())):
        return None                                     # not that agent's request
    return g


def _duration(s: str) -> tuple[int, int]:
    """(granted seconds, asked seconds) for 90m / 2h / 1h30m / 3 (hours)."""
    t = s.strip().lower().replace(" ", "")
    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m(?:in)?)?", t)
    if t.isdigit():
        asked = int(t) * 3600
    elif m and (m.group(1) or m.group(2)):
        asked = int(m.group(1) or 0) * 3600 + int(m.group(2) or 0) * 60
    else:
        die("--grant takes a duration like 45m, 2h or 1h30m", 2)
        raise AssertionError
    if asked < 60:
        die("--grant needs at least 1 minute", 2)
    return min(asked, MAX_GRANT), asked


def dialog_program() -> str:
    """VeloGuard's own dialog (Esc = Deny, Ctrl+Enter = Approve; Rust, rust/ask)
    when it's installed root-owned and not writable by anyone else — this runs
    as root — else zenity (same flags, same exit codes)."""
    ask = HERE / "bin" / "veloguard-ask"
    try:
        st = os.stat(ask)
        if st.st_uid == 0 and not st.st_mode & 0o022 and os.access(ask, os.X_OK):
            return str(ask)
    except OSError:
        pass
    return "zenity"


def ask(conn: socket.socket, title: str, text: str) -> str:
    """approved | denied | timeout — from a dialog only the user can answer."""
    tmp = tempfile.mkdtemp(prefix="vg-elevate-")          # root's, 0700
    os.makedirs(f"{tmp}/config", mode=0o700)
    fd = conn.fileno()
    os.set_inheritable(fd, True)
    env = {"WAYLAND_SOCKET": str(fd), "GDK_BACKEND": "wayland",
           "XDG_RUNTIME_DIR": tmp, "HOME": tmp, "XDG_CONFIG_HOME": f"{tmp}/config",
           "XDG_DATA_HOME": f"{tmp}/data", "XDG_CACHE_HOME": f"{tmp}/cache",
           "GSETTINGS_BACKEND": "memory", "NO_AT_BRIDGE": "1", "GTK_A11Y": "none",
           "PATH": "/usr/bin", "LANG": os.environ.get("LANG", "C.UTF-8")}
    try:
        r = subprocess.run(
            [dialog_program(), "--question", "--title", title[:120],
             "--text", text, "--ok-label", "Approve", "--cancel-label", "Deny",
             "--default-cancel", "--icon", "dialog-warning", "--width", "600",
             "--timeout", str(TIMEOUT)],
            env=env, pass_fds=(fd,), stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=TIMEOUT + 15)
        code = r.returncode
    except (OSError, subprocess.TimeoutExpired):
        code = -1
    finally:
        subprocess.run(["rm", "-rf", "--", tmp], check=False)
    return {0: "approved", 5: "timeout"}.get(code, "denied")


def command_text(who: dict, shown: str, cwd: str, warning: str, reason: str, timeout: int) -> str:
    e = html.escape
    t = (f"<b>{e(who['name'])}</b> wants to run a command as <b>root</b>:\n\n"
         f"<tt>{e(shown)}</tt>\n\nin <tt>{e(cwd)}</tt>\n")
    if timeout:
        t += f"<small>(VeloGuard stops it after {_span(timeout)} if it's still running)</small>\n"
    if reason:
        t += f"\nIts reason, in its own words: <i>{e(reason)}</i>\n"
    if warning:
        t += f"\n<span foreground='#e01b24'><b>⚠ VeloGuard: this {e(warning)}.</b></span>\n"
    return t + "\n" + who_pango(who) + "\n\nApprove only if you asked for this."


def main() -> None:
    if os.geteuid() != 0:
        die("must be started through pkexec (veloguard-elevate)", 2)
    try:
        uid = int(os.environ["PKEXEC_UID"])
        user = pwd.getpwuid(uid).pw_name
    except (KeyError, ValueError):
        die("must be started through pkexec (veloguard-elevate)", 2)
    o = parse(sys.argv[1:])
    claimed = o["agent"] if AGENT_RE.match(o["agent"]) else "a program"
    if o["mode"] in ("revoke", "grant-status"):
        return grant_admin(o, uid, user, claimed)
    who = who_is_asking(claimed, uid)
    reason = clean_reason(o["reason"])
    if o["mode"] == "grant":
        return grant_cmd(o, uid, user, who, reason)
    cmd = o["cmd"]
    if not cmd:
        die("no command given", 2)
    cwd = os.path.realpath(o["cwd"]) if os.path.isdir(o["cwd"]) else "/"
    shown = shlex.join(cmd)
    entry = {"agent": who.get("name"), "who": who_line(who), "verified": who.get("verified"),
             "agent_pid": who.get("pid"), "user": user, "cwd": cwd, "argv": cmd,
             **({"reason": reason} if reason else {}),
             **({"timeout": o["timeout"]} if o["timeout"] else {})}

    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)                     # one question at a time

    verdict, why, cls = guard_verdict(cmd, cwd)
    grant = load_grant(uid)
    # What the guard would refuse goes to the person, with the reason in red;
    # a grant covers maintenance of the guard's files, never switching it off.
    must_ask = verdict == "deny" and not (grant and cls == "tamper")
    if grant and not must_ask:
        audit({**entry, "result": "approved-by-grant", "grant_expires": grant["expires"],
               **({"note": why} if verdict != "allow" else {})})
        lock.close()
        report("approved", "by the grant you gave", grant_expires=int(grant["expires"]))
        return run_as_root(cmd, cwd, uid, user, who.get("name", ""), shown, o["timeout"])
    if len(shown) > MAX_SHOWN:
        audit({**entry, "result": "denied", "why": "too long to show"})
        die(f"denied: the command is too long to show for approval ({len(shown)} chars) — "
            "put it in a script and run that")
    conn = verified_compositor(uid)
    if conn is None:
        audit({**entry, "result": "denied", "why": "no verified desktop session"})
        die("denied: no desktop session to ask you on (approval needs your screen) — "
            "run the command yourself in a terminal", decision="no_desktop")
    if verdict == "deny":
        why = (f"{why} — it switches off part of VeloGuard's own protection" if cls == "disable"
               else f"{why} — it changes VeloGuard's own files")
    answer = ask(conn, f"VeloGuard — {who['name']} asks for root",
                 command_text(who, shown, cwd, why if verdict in ("warn", "deny") else "",
                              reason, o["timeout"]))
    conn.close()
    audit({**entry, "result": answer, **({"warning": why} if verdict == "warn" else {})})
    lock.close()
    if answer != "approved":
        die("denied by you" if answer == "denied" else "no answer in time — denied",
            decision="denied" if answer == "denied" else "timeout")
    report("approved", "by you")
    run_as_root(cmd, cwd, uid, user, who.get("name", ""), shown, o["timeout"])


def _current_grant() -> dict | None:
    try:
        g = json.load(open(GRANT))
        return g if time.time() < g.get("expires", 0) else None
    except (OSError, ValueError):
        return None


def grant_admin(o: dict, uid: int, user: str, claimed: str) -> None:
    if o["mode"] == "revoke":
        try:
            os.unlink(GRANT)
            _clear_status()
            audit({"agent": claimed, "user": user, "result": "grant-revoked"})
            report("revoked", "grant revoked")
            print("grant revoked")
        except FileNotFoundError:
            _clear_status()
            report("revoked", "there was no grant")
            print("no grant")
        return
    g = _current_grant()
    if o["json"]:
        print(json.dumps({"active": False} if g is None else {
            "active": True, "agent": g.get("agent"), "who": g.get("who"), "pid": g.get("pid"),
            "start": g.get("start"), "expires": int(g["expires"]),
            "minutes_left": int(g["expires"] - time.time()) // 60}))
        return
    print("no grant" if g is None else
          f"{g['agent']} (pid {g['pid']}): {int(g['expires'] - time.time()) // 60} min left")


def grant_cmd(o: dict, uid: int, user: str, who: dict, reason: str) -> None:
    secs, asked = _duration(o["grant"])
    if not who.get("verified"):
        audit({"agent": who.get("name"), "who": who_line(who), "user": user,
               "result": "grant-refused", "why": "not an AI agent's session"})
        die("a grant is for an AI agent's own session — run this from inside the agent "
            f"(this request came from {who.get('name')})", 2, decision="refused")
    conn = verified_compositor(uid)
    if conn is None:
        die("denied: no desktop session to ask you on", decision="no_desktop")
    e = html.escape
    text = (f"<b>{e(who['name'])}</b> asks to run root commands <b>without asking you</b> "
            f"for the next <b>{_span(secs)}</b>, so it can work while you're away.\n")
    if asked > secs:
        text += f"<small>(it asked for {_span(asked)}; the most VeloGuard gives is {_span(MAX_GRANT)})</small>\n"
    if reason:
        text += f"\nIts reason, in its own words: <i>{e(reason)}</i>\n"
    text += (f"\n• Only this one running agent — process {who['pid']}"
             + (f" ({e(who['role'])})" if who.get("role") else "")
             + " and what it starts. Any other program still gets this dialog.\n"
             "• It may update VeloGuard's own files (maintenance).\n"
             "• It still can't switch the guard off: its services, firewall and audit log stay refused.\n"
             "• Every command is written to the audit log; it ends on reboot, when that process exits, "
             "or with <tt>veloguard-elevate --revoke</tt>.\n")
    old = _current_grant()
    if old and old.get("pid") != who["pid"]:
        text += (f"\n<span foreground='#f5a623'>This replaces the grant {e(str(old.get('agent')))} has now "
                 f"({int(old['expires'] - time.time()) // 60} min left).</span>\n")
    text += "\n" + who_pango(who) + "\n\n<span foreground='#e01b24'><b>Approve only if you asked for this.</b></span>"
    answer = ask(conn, f"VeloGuard — {who['name']} asks for {_span(secs)} of root", text)
    conn.close()
    anchor = {"pid": who["pid"], "start": who["start"], "exe": who["exe"]}
    audit({"agent": who["name"], "who": who_line(who), "user": user, "result": f"grant-{answer}",
           "seconds": secs, "asked_seconds": asked, "anchor": anchor,
           **({"reason": reason} if reason else {})})
    if answer != "approved":
        die("denied by you" if answer == "denied" else "no answer in time — denied",
            decision="denied" if answer == "denied" else "timeout")
    expires = time.time() + secs
    os.makedirs(os.path.dirname(GRANT), mode=0o700, exist_ok=True)
    fd = os.open(GRANT + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({**anchor, "uid": uid, "agent": who["name"], "who": who_line(who),
                   "expires": expires, "scope": "maintenance"}, f)
    os.replace(GRANT + ".tmp", GRANT)
    _write_status(int(expires), who["name"], {**anchor, "who": who_line(who)})
    report("granted", "by you", seconds=secs, asked_seconds=asked, expires=int(expires),
           pid=who["pid"])
    print(f"granted: {who['name']} may run root commands without asking for {_span(secs)}")


def _write_atomic(path: str, text: str) -> None:
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def _write_status(expires: int, agent: str, info: dict) -> None:
    try:
        _write_atomic(GRANT_STATUS, f"{expires} {agent}\n")
        _write_atomic(GRANT_INFO, json.dumps({"expires": expires, "agent": agent, **info}) + "\n")
    except OSError:
        pass


def _clear_status() -> None:
    for p in (GRANT_STATUS, GRANT_INFO):
        try:
            os.unlink(p)
        except OSError:
            pass


def run_as_root(cmd: list[str], cwd: str, uid: int, user: str, agent: str, shown: str,
                timeout: int = 0) -> None:
    pw = pwd.getpwuid(uid)
    env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin", "HOME": "/root",
           "LANG": os.environ.get("LANG", "C.UTF-8"), "TERM": os.environ.get("TERM", "dumb"),
           "SUDO_USER": user, "SUDO_UID": str(uid), "SUDO_GID": str(pw.pw_gid),
           "SUDO_COMMAND": shown[:MAX_SHOWN], "VELOGUARD_ELEVATED_FOR": agent}
    os.chdir(cwd)
    if not timeout:
        try:
            os.execvpe(cmd[0], cmd, env)
        except OSError as e:
            die(f"{cmd[0]}: {e.strerror}", 127, decision="failed")
    # A time limit: the requester runs as the user and can't signal a root
    # process, so root keeps the clock — the command gets its own process
    # group, TERM at the limit, KILL 5 s later, exit 124 (like timeout(1)).
    try:
        p = subprocess.Popen(cmd, env=env, start_new_session=True)
    except OSError as e:
        die(f"{cmd[0]}: {e.strerror}", 127, decision="failed")
        raise AssertionError
    try:
        rc = p.wait(timeout=timeout)
        sys.exit(128 - rc if rc < 0 else rc)
    except subprocess.TimeoutExpired:
        for sig, wait in ((15, 5), (9, 5)):
            try:
                os.killpg(p.pid, sig)
            except ProcessLookupError:
                break
            try:
                p.wait(timeout=wait)
                break
            except subprocess.TimeoutExpired:
                continue
        print(f"veloguard-elevate: stopped after {_span(timeout)} (the time limit)", file=sys.stderr)
        sys.exit(124)


if __name__ == "__main__":
    main()
