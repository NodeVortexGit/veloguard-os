#!/usr/bin/env bash
#
# veloguard — the guard launcher. Prefers the compatible-Python venv (so
# ChromaDB / semantic memory works even when the system Python is too new),
# and falls back to the system python3 otherwise.
#
#   veloguard "block 203.0.113.10"
#   veloguard setup
#   veloguard honeypot --analyze
#
set -euo pipefail
# Resolve symlinks: /usr/local/bin/<this> -> /opt/veloguard/bin/<this>. With a
# bare dirname "$0" HOME_DIR became /usr/local and `-m guardd` didn't exist.
HOME_DIR="${VELOGUARD_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
VENV="${VELOGUARD_VENV:-$HOME_DIR/.venv}"

# check-command — what every agent's hook asks before each tool call — runs in
# Rust (rust/src/cmdguard.rs, same verdicts byte for byte): ~3 ms instead of
# ~63 ms of Python start-up. Only a root-owned binary nobody else can write;
# else, or with VELOGUARD_PYTHON_CMDGUARD=1, Python answers as before.
if [ "${1:-}" = check-command ] && [ -z "${VELOGUARD_PYTHON_CMDGUARD:-}" ]; then
  RS="$HOME_DIR/bin/veloguard-check"
  if [ -x "$RS" ] && read -r own mode < <(stat -Lc '%u %a' -- "$RS") \
     && [ "$own" = 0 ] && (( (8#$mode & 8#022) == 0 )); then
    shift
    exec "$RS" "$@"
  fi
fi

PY="python3"
[ -x "$VENV/bin/python" ] && PY="$VENV/bin/python"

cd "$HOME_DIR"
exec "$PY" -m guardd "$@"
