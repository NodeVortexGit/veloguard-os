[Unit]
Description=VeloGuardOS hardware/driver setup (Omarchy-derived, first boot)
# Needs the network up to fetch drivers. Runs until it has succeeded once —
# or, when the installer couldn't download the chosen desktop, until that
# desktop is installed too (the `|` makes these two conditions an OR).
Wants=network-online.target
After=network-online.target
ConditionPathExists=|!/var/lib/veloguard/.hardware-done
ConditionPathExists=|/var/lib/veloguard/desktop-pending

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/veloguard-hardware
# Only stamped when the run succeeds; all.sh exits 75 when offline so the
# drivers are retried on the next boot instead of being skipped forever.
ExecStartPost=/usr/bin/bash -c 'mkdir -p /var/lib/veloguard && touch /var/lib/veloguard/.hardware-done'
# A first-boot full upgrade + DKMS builds — and, after an offline install, the
# chosen desktop (Clean Config builds from source) — take a while on slow
# links. Nothing waits on this unit (it isn't ordered before any target), and
# a timeout here would kill pacman mid-transaction.
TimeoutStartSec=3h

[Install]
WantedBy=multi-user.target
