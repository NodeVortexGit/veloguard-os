[Unit]
Description=VeloGuardOS hardware/driver setup (Omarchy-derived, first boot)
# Needs the network up to fetch drivers, and runs once.
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/veloguard/.hardware-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/veloguard-hardware
# Only stamped when the run succeeds; all.sh exits 75 when offline so the
# drivers are retried on the next boot instead of being skipped forever.
ExecStartPost=/usr/bin/bash -c 'mkdir -p /var/lib/veloguard && touch /var/lib/veloguard/.hardware-done'
# A first-boot full upgrade + DKMS builds can take a while on slow links.
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
