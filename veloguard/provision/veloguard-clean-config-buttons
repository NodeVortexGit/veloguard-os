#!/usr/bin/env python3
"""veloguard-clean-config-buttons — fit VeloGuard's own buttons into Clean
Config's quick panel, and change nothing else.

Clean Config (NodeVortex's Clean_Config_Hyperland) is installed as published:
its island, its look, its keys. What it can't have on its own are the
buttons only VeloGuard has, so they go where Clean Config keeps its
controls — the quick panel the island expands into (Meta, or a click on the
pill), in the card with Focus and Airplane, drawn with that card's own
toggle and pill styles:

    [ VPN ] [ Trusted ]                 two more toggles, like Focus / Airplane
    (🛡 Guard)  (AI agent)  (AI 42%)    pills, like the Galaxy Buds actions

  VPN      on/off through veloguard-vpn (the provider app or WireGuard)
  Trusted  this Wi-Fi / wired network trusted or not (untrusted → auto-VPN)
  Guard    the guard menu: VPN providers, trust, agents, Bulgarian Mode, status
  AI agent opens your default AI agent
  AI …%    the AI plan usage (VeloGuard's usage view)

One block is inserted into modules/bar/island/FullScreen.qml of the
installed shell (/etc/xdg/quickshell/caelestia), right after the Focus /
Airplane row; nothing in the file is changed or removed. Idempotent. If a
future Clean Config moves that row, the insertion point isn't found and the
shell stays exactly as published (exit 0, a note in the log).

  veloguard-clean-config-buttons [SHELL_DIR]
"""
from __future__ import annotations

import os
import re
import sys

MARKER = "VeloGuard (added by VeloGuardOS"

BLOCK = '''
// ── VeloGuard (added by VeloGuardOS — veloguard-clean-config-buttons) ──
// The guard's own buttons, in this card's toggle and pill styles. Nothing
// else in Clean Config is changed.
Item {
    id: veloGuard

    visible: false
    property bool vpn: false
    property bool trusted: false
    property bool onNetwork: false
    property string network: ""
    property string guardText: "🛡"
    property string guardClass: "ok"
    property string usage: ""
    property bool usageHigh: false

    function run(cmd: string): void {
        Quickshell.execDetached(["sh", "-c", cmd]);
        veloGuardRefresh.restart();
    }
    function open(cmd: string): void {
        Island.collapse();
        Quickshell.execDetached(["sh", "-c", cmd]);
    }

    Process {
        id: veloGuardState

        running: true
        command: ["veloguard-bar", "panel-state"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const d = JSON.parse(this.text);
                    veloGuard.vpn = d.vpn;
                    veloGuard.trusted = d.trusted;
                    veloGuard.onNetwork = d.onNetwork;
                    veloGuard.network = d.network;
                    veloGuard.guardText = d.guardText;
                    veloGuard.guardClass = d.guardClass;
                    veloGuard.usage = d.usage;
                    veloGuard.usageHigh = d.usageHigh;
                } catch (e) {}
            }
        }
    }

    Timer {
        id: veloGuardRefresh

        interval: 2500
        running: true
        repeat: true
        onTriggered: veloGuardState.running = true
    }
}

RowLayout {
    Layout.alignment: Qt.AlignHCenter
    spacing: Tokens.spacing.large

    QuickToggle {
        icon: "vpn_lock"
        label: veloGuard.vpn ? qsTr("VPN on") : qsTr("VPN off")
        checked: veloGuard.vpn
        onToggled: veloGuard.run(veloGuard.vpn ? "pkexec veloguard-vpn disconnect" : "pkexec veloguard-vpn connect")
    }

    QuickToggle {
        icon: "verified_user"
        label: !veloGuard.onNetwork ? qsTr("No network") : veloGuard.trusted ? qsTr("Trusted") : qsTr("Untrusted")
        checked: veloGuard.trusted
        onToggled: {
            if (veloGuard.onNetwork)
                veloGuard.run("pkexec veloguard-wifi-trust " + (veloGuard.trusted ? "untrust" : "trust"));
        }
    }
}

Flow {
    Layout.alignment: Qt.AlignHCenter
    Layout.preferredWidth: 340
    spacing: Tokens.spacing.small

    Repeater {
        model: [
            {
                icon: "shield",
                text: veloGuard.guardClass === "ok" || veloGuard.guardClass === "vpn-up" ? qsTr("Guard") : veloGuard.guardText,
                tone: veloGuard.guardClass,
                cmd: "veloguard-guard-menu"
            },
            {
                icon: "smart_toy",
                text: qsTr("AI agent"),
                tone: "ok",
                cmd: "veloguard-agent"
            },
            {
                icon: "data_usage",
                text: veloGuard.usage !== "" ? qsTr("AI %1").arg(veloGuard.usage) : qsTr("AI usage"),
                tone: veloGuard.usageHigh ? "update" : "ok",
                cmd: "veloguard-quickpanel --usage"
            }
        ]

        Item {
            id: veloGuardPill

            required property var modelData
            readonly property color tint: modelData.tone === "alert" || modelData.tone === "grant" ? Colours.palette.m3error
                : modelData.tone === "untrusted" || modelData.tone === "update" ? "#f2c66d" : DarkAccent.text

            implicitWidth: veloGuardPillRow.implicitWidth + Tokens.padding.medium * 2
            implicitHeight: veloGuardPillRow.implicitHeight + Tokens.padding.small * 2

            StyledRect {
                anchors.fill: parent
                radius: Tokens.rounding.full
                color: DarkAccent.surfaceHigh

                StateLayer {
                    radius: Tokens.rounding.full
                    onClicked: veloGuard.open(veloGuardPill.modelData.cmd)
                }
            }

            RowLayout {
                id: veloGuardPillRow

                anchors.centerIn: parent
                spacing: Tokens.spacing.extraSmall

                MaterialIcon {
                    text: veloGuardPill.modelData.icon
                    color: veloGuardPill.tint
                    fontStyle: Tokens.font.icon.builders.small.build()
                }

                StyledText {
                    text: veloGuardPill.modelData.text
                    color: veloGuardPill.tint
                    font: Tokens.font.body.small
                }
            }
        }
    }
}
// ── end VeloGuard ──
'''

# The Focus / Airplane row: the Airplane toggle, then the line closing its row.
ANCHOR = re.compile(
    r'(?P<toggle>^(?P<ind>[ \t]*)QuickToggle \{\s*\n'
    r'(?:(?!^[ \t]*QuickToggle \{).*\n)*?'
    r'[ \t]*onToggled: Airplane\.toggle\(\)\s*\n'
    r'(?P=ind)\}\s*\n)'
    r'(?P<close>^[ \t]*\}[ \t]*\n)', re.M)


def main() -> int:
    shell = sys.argv[1] if len(sys.argv) > 1 else "/etc/xdg/quickshell/caelestia"
    path = os.path.join(shell, "modules/bar/island/FullScreen.qml")
    try:
        with open(path, encoding="utf-8") as f:
            src = f.read()
    except OSError as e:
        print(f"[clean-config] VeloGuard buttons: {path} not readable ({e}) — skipped")
        return 0
    if MARKER in src:
        print("[clean-config] VeloGuard buttons: already in the quick panel")
        return 0
    m = ANCHOR.search(src)
    if not m:
        print("[clean-config] VeloGuard buttons: the Focus / Airplane row moved in this Clean Config — "
              "quick panel left exactly as published (the guard menu: veloguard-guard-menu)")
        return 0
    indent = re.match(r"[ \t]*", m.group("close")).group(0)
    block = "\n" + "".join((indent + line if line.strip() else line) + "\n" for line in BLOCK.strip("\n").split("\n"))
    out = src[:m.end("close")] + block + src[m.end("close"):]
    # sanity: the insertion is balanced on its own
    if block.count("{") != block.count("}"):
        print("[clean-config] VeloGuard buttons: internal error (unbalanced block) — skipped")
        return 0
    tmp = path + ".veloguard-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(out)
    os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)
    print("[clean-config] VeloGuard buttons added to the quick panel (VPN, Trusted, Guard, AI agent, AI usage)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
